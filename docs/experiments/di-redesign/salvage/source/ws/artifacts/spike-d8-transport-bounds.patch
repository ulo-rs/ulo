diff --git a/crates/ulo-http-axum/src/lib.rs b/crates/ulo-http-axum/src/lib.rs
index 352b375f..07d97f1c 100644
--- a/crates/ulo-http-axum/src/lib.rs
+++ b/crates/ulo-http-axum/src/lib.rs
@@ -38,3 +38,29 @@ pub use tokio_sender::TokioSender;
 pub use ulo::http::HttpAdapter;
 
 pub use ulo::ws::WsAdapter;
+
+// ── D8 SPIKE (temporary) ────────────────────────────────────────────────────
+// Proves the split halves carry the bounds a core-owned connection loop needs.
+#[cfg(test)]
+mod d8_spike {
+    #[allow(dead_code)]
+    fn assert_send_static<T: Send + 'static>() {}
+
+    #[allow(dead_code)]
+    fn generic_core_loop<S, K, M, E>(_read: S, _write: K)
+    where
+        S: futures_util::Stream<Item = Result<M, E>> + Send + 'static,
+        K: futures_util::Sink<M> + Send + 'static,
+        M: Send + 'static,
+        E: Send + 'static,
+    {
+    }
+
+    #[test]
+    fn split_halves_are_send_static() {
+        assert_send_static::<futures_util::stream::SplitStream<axum::extract::ws::WebSocket>>();
+        assert_send_static::<
+            futures_util::stream::SplitSink<axum::extract::ws::WebSocket, axum::extract::ws::Message>,
+        >();
+    }
+}
