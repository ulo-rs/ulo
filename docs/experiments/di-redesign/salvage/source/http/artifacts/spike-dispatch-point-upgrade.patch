+/// SPIKE: stands in for `Dispatched`. The decision is taken by code that sees
+/// only the framework-side `HttpRequest`, never a poem type.
+enum SpikeDispatched {
+    /// Core matched an ordinary route (the spike lets poem's router serve it).
+    Respond,
+    /// Core matched a WebSocket path and hands back the callbacks.
+    Upgrade(Arc<WsConnectionCallbacks>),
+}
+
+/// SPIKE: stands in for `ServeContext::dispatch`.
+fn spike_dispatch(
+    ws_routes: &[(String, Arc<WsConnectionCallbacks>)],
+    req: &HttpRequest,
+) -> SpikeDispatched {
+    if req.method() == http::Method::GET {
+        let path = req.uri().path().to_string();
+        for (pattern, callbacks) in ws_routes {
+            if pattern.as_str() == path.as_str() {
+                return SpikeDispatched::Upgrade(callbacks.clone());
+            }
+        }
+    }
+    SpikeDispatched::Respond
+}
